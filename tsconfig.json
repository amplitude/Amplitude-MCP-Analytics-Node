{
  "compilerOptions": {
    "target": "ESNext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true,
    "incremental": true,
    "noEmit": true,
    "tsBuildInfoFile": ".typecheck.tsbuildinfo",
    "paths": {
      "@amplitude/mcp-analytics/src/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "src",
    "test",
    "vitest.config.ts"
  ]
}